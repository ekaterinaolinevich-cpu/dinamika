# Порт HTTP-сервера
PORT=3000

# Токен бота от @BotFather. Если пусто — демо-режим без подписи Telegram.
BOT_TOKEN=

# Публичный HTTPS-адрес мини-аппа (нужен для кнопки в боте).
# На Bothost можно не задавать — платформа сама передаёт DOMAIN.
WEBAPP_URL=

# Postgres (Neon). Если задан — данные в базе, иначе локальный SQLite.
DATABASE_URL=

# Путь к файлу SQLite, когда DATABASE_URL не задан.
DATABASE_PATH=./data/dinamika.db

# Секрет вебхука (необязательно).
WEBHOOK_SECRET=

# 0 — не засевать демо-данные при старте.
SEED_DEMO=1
